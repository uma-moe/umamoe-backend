# Native development against the disposable Compose database.
# Copy to .env in a new checkout; merge these values if .env already exists.
# First run: docker compose -f compose.local.yml run --build --rm demo-db

# Bypass Turnstile verification for local development
API_PROTECTION_BYPASS=true

# Keep seeded history stable while developing; user writes still work.
SKIP_MIGRATIONS=false
DISABLE_DB_BACKGROUND_JOBS=true
DISABLE_BOOKMARK_HASH_BACKFILL=true

# Matches compose.local.yml. These credentials are only for local demo data.
DATABASE_URL=postgresql://umamoe_demo:umamoe_demo@127.0.0.1:55432/umamoe_demo
DEMO_DATABASE_URL=postgresql://umamoe_demo:umamoe_demo@127.0.0.1:55432/umamoe_demo
JWT_SECRET=local-demo-jwt-secret-not-for-production
BROWSER_PROOF_SECRET=local-demo-browser-secret-not-for-production
BROWSER_PROOF_COOKIE_SECURE=false

# Shared token/cache store for split API services
# Empty uses the existing in-process fallback. Compose supplies Redis in Docker.
REDIS_URL=
REDIS_KEY_PREFIX=umamoe-demo
BROWSER_PROOF_INTERNAL_PORT=3201
# Local development uses localhost; Docker deployment uses http://umamoe-search:3202.
SEARCH_SERVICE_URL=http://127.0.0.1:3002
SIMULATOR_URL=http://127.0.0.1:3009

# CORS origins for local development
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Server configuration
HOST=127.0.0.1
PORT=3001

# Debug mode - enables verbose logging (set to false for production)
DEBUG_MODE=true
